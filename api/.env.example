# Set these in the API host's environment settings (Railway / Render).
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=api.avtomobilebi.ge
# The site proxies /api to this API, so the site's origin must be trusted.
DJANGO_CSRF_TRUSTED_ORIGINS=https://avtomobilebi.ge,https://www.avtomobilebi.ge
DATABASE_URL=postgres://user:password@host:5432/avtomobilebi
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a safe copy: if this key is lost, stored personal ID numbers and phones can't be read.
FIELD_ENCRYPTION_KEY=
# Same random value as INTERNAL_API_TOKEN on the site (Vercel).
INTERNAL_API_TOKEN=
SITE_URL=https://avtomobilebi.ge

# Car photos in Cloudflare R2 (or any S3-compatible bucket).
S3_BUCKET=
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_DOMAIN=photos.avtomobilebi.ge

# Email (any SMTP provider).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@avtomobilebi.ge
SUPPORT_PHONE=

# Printed on invoices.
INVOICE_BANK_DETAILS=
